{
	"name": "web-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:desktop": "vite dev --mode desktop --host 127.0.0.1 --port 5173 --strictPort",
		"dev:desktop-public": "node dev-desktop-public.mjs",
		"router": "9router --host 127.0.0.1 --port 20128 --no-browser --skip-update",
		"test:chat": "bun test tests/chat.test.ts",
		"test:voice-chat": "bun test tests/voice-chat.test.ts tests/voice-chat-turn-detector.test.ts tests/voice-chat-speech-language.test.ts tests/voice-chat-stt.test.ts tests/voice-chat-desktop.test.ts",
		"test:voice-chat:browser": "playwright test --config playwright.voice-chat.config.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-arabic": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.45.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-exmarkdown": "^5.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"9router": "0.5.75",
		"@diffusionstudio/piper-wasm": "1.0.0",
		"@huggingface/transformers": "^4.3.0",
		"@svar-ui/svelte-grid": "^2.7.3",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"vosk-browser": "0.0.8",
		"wavesurfer.js": "^7.12.12"
	},
	"trustedDependencies": [
		"9router"
	]
}
