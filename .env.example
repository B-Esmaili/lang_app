DATABASE_URL=postgresql://postgres:123@127.0.0.1:5432/AI

# Encrypts users' personal AI API keys at rest. Generate a distinct, stable secret in production.
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-secret

# Server-only credential used for prerecorded MP3 transcription.
DEEPGRAM_API_KEY=replace-with-deepgram-key

# adapter-node defaults to 512 KB; allow 50 MB media uploads plus multipart overhead.
BODY_SIZE_LIMIT=52M

# Uploaded audio, video, and image files are stored here. Mount this directory as persistent storage in production.
MEDIA_STORAGE_DIR=./data/media

# Better Auth requires a stable, random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173

# Development creates the temporary admin/123456 account by default. To disable:
# BETTER_AUTH_BOOTSTRAP_ADMIN=false
# Production stays disabled unless explicitly enabled and requires all identity
# values below. Use a strong password rather than the development default.
# BETTER_AUTH_BOOTSTRAP_ADMIN=true
# BETTER_AUTH_BOOTSTRAP_ADMIN_USERNAME=replace-with-admin-username
# BETTER_AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# BETTER_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BETTER_AUTH_BOOTSTRAP_ADMIN_NAME=Administrator
